# Supabase — eigenes Projekt unter https://supabase.com/dashboard
# Settings -> API Keys. Nur der publishable/anon Key gehoert in den Client.
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=

# KEIN service_role Key hier. Der hebelt jede RLS-Policy aus und hat weder in
# der .env noch im Repo etwas verloren. Serverseitige Aufgaben laufen ueber
# Supabase Edge Functions, deren Secrets per `supabase secrets set` gesetzt
# werden und nie das Geraet erreichen.

# Sprachmemo-Transkription: erst auf true, wenn die Edge Function steht
VITE_VOICE_ENABLED=false
